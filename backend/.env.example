# Backend configuration template. Copy to .env and adjust.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Data ingestion limits (Module 2) ----
# All of these are optional. The values below are the defaults.
# UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_XLSX_UNCOMPRESSED_MB=100
MAX_ROWS=100000
MAX_COLUMNS=100
PREVIEW_DEFAULT_ROWS=5
PREVIEW_MAX_ROWS=20
PREVIEW_MAX_CELL_LENGTH=100
# ---- Profiling (Module 3). Optional, defaults shown. ----
PROFILE_TOP_VALUES=10
PROFILE_VALUE_MAX_LENGTH=50

# ---- Question answering (Module 4). Backend only: NEVER put the key in frontend/.env ----
# Get a key from Google AI Studio. Leave it empty to use only the rule-based classifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MIN_CONFIDENCE=0.5
MAX_QUESTION_LENGTH=500
CURRENCY_SYMBOL=₹

# ---- PostgreSQL (Module 6). Backend only. NEVER put these in frontend/.env. ----
# STORAGE_BACKEND=json keeps today's file-based behavior and needs no database running.
# Docker Compose overrides this to "postgres" automatically for containers -- you
# normally do NOT change this in your local .env used for plain `pytest`/`uvicorn`.
STORAGE_BACKEND=json
POSTGRES_USER=insightflow
POSTGRES_PASSWORD=devpassword123
POSTGRES_DB=insightflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432