# Docker Compose / full-stack environment example.
# Copy to the repository root as .env and edit locally.
# Never commit .env.

POSTGRES_USER=insightflow
POSTGRES_PASSWORD=your_local_password_here
POSTGRES_DB=insightflow
POSTGRES_HOST_PORT=5433

# Optional. Do not place this value in frontend variables.
GEMINI_API_KEY=your_gemini_api_key_here

# Public browser URL compiled into the React app.
VITE_API_URL=http://localhost:8001

# Browser origins allowed by FastAPI.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
